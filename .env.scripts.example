# Credenziali di GESTIONE per gli script in scripts/ (setup-staging.sh, configure-auth.sh).
#
# NON è il .env dell'app: qui vanno i segreti di AMMINISTRAZIONE Supabase, non le
# chiavi runtime (quelle stanno in .env). Questo file è caricato in automatico
# dagli script se presente.
#
# COME USARLO:
#   cp .env.scripts.example .env.scripts   # poi compila i valori qui sotto
#   ./scripts/setup-staging.sh             # legge i valori da .env.scripts
#
# ⚠️ .env.scripts è ignorato da Git (vedi .gitignore). NON committarlo mai:
#    il Personal Access Token dà accesso completo al tuo account Supabase.

# ---- Obbligatori -------------------------------------------------------------

# Personal Access Token: Supabase Dashboard -> Account -> Access Tokens -> Generate.
# Inizia con "sbp_". Dà accesso a tutta la Management API: trattalo come una password.
SUPABASE_ACCESS_TOKEN=sbp_...

# ID dell'organizzazione in cui creare il progetto staging. Per trovarlo:
#   curl -s https://api.supabase.com/v1/organizations \
#     -H "Authorization: Bearer $SUPABASE_ACCESS_TOKEN" | jq
SUPABASE_ORG_ID=

# ---- Opzionali: creazione progetto staging -----------------------------------

# Region del nuovo progetto (default: eu-central-1, Francoforte — vicina all'Italia).
# SUPABASE_REGION=eu-central-1

# Nome del progetto staging (default: dry-nights-staging).
# STAGING_PROJECT_NAME=dry-nights-staging

# Password del database staging. Se lasciata vuota, lo script ne genera una sicura
# e te la stampa a fine esecuzione (salvala in un password manager).
# DB_PASS=

# ---- Opzionali: Auth / redirect ---------------------------------------------

# Sovrascrivi i redirect di staging se la porta di dev o il pattern preview di
# Vercel sono diversi dai default (http://localhost:5173 e https://*-lomy79.vercel.app).
# STAGING_SITE_URL=http://localhost:5173
# STAGING_REDIRECT_URLS=http://localhost:5173,https://*-lomy79.vercel.app

# Blocca le registrazioni (true = solo utenti già esistenti possono entrare).
# Tienilo su false finché non hai creato gli account genitore col magic link.
# AUTH_DISABLE_SIGNUP=false

# Scadenza del magic link in secondi (default 3600 = 1 ora).
# MAGICLINK_EXP=3600

# ---- Opzionali: promemoria push (scripts/setup-notifiche.sh) -----------------
# Normalmente NON serve impostare nulla qui: lo script genera le chiavi VAPID al
# primo giro e poi le rilegge dai secrets del progetto, così è rilanciabile senza
# invalidare le iscrizioni già fatte.

# Indirizzo di contatto richiesto dallo standard VAPID: i push service lo usano
# per avvisarti se qualcosa non va (default: mailto:promemoria@notti-serene.app).
# VAPID_SUBJECT=mailto:tu@tuodominio.it

# true = rigenera le chiavi VAPID anche se ce ne sono già.
# ⚠️ Invalida TUTTE le iscrizioni: ogni telefono deve riattivare i promemoria.
# VAPID_RIGENERA=false

# true = a fine setup manda un push di prova a tutti i dispositivi iscritti,
# ignorando orari e regola del silenzio. Utile per non aspettare le 23.
# PROVA=false

# ---- Opzionali: SMTP custom (email affidabili in produzione) ------------------
# Il mailer integrato di Supabase è solo per test (poche email/ora, rischio spam).
# Per un uso reale usa un SMTP tuo (Resend, Brevo, SendGrid — tutti con free tier).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=no-reply@tuodominio.it
# SMTP_SENDER_NAME=Notti serene
